{
  "mcpServers": {
    "mcp_gateway": {
      "type": "streamable-http",
      "url": "http://mcp:3000/mcp",
      "headers": {
        "Authorization": "Bearer __MCP_API_KEY__"
      }
    },
    "code_sandbox": {
      "type": "streamable-http",
      "url": "http://sandbox-mcp:8000/mcp"
    },
    "android_build": {
      "type": "streamable-http",
      "url": "http://android-mcp:8000/mcp"
    },
    "excalidraw": {
      "type": "streamable-http",
      "url": "http://excalidraw-mcp:8000/mcp"
    }
  }
}
